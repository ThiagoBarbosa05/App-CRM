# ========================================
# Configurações de Automação (Opcional)
# ========================================

# Chave secreta para proteger endpoints de automação
# Descomente para ativar autenticação nos endpoints
# AUTOMATION_SECRET_KEY=sua-chave-super-secreta-aqui

# Ambiente de execução (development, production)
NODE_ENV=production

# ========================================
# Configurações Umbler (Obrigatório)
# ========================================

# ID da organização no Umbler
UMBLER_ORGANIZATION_ID=sua-org-id

# Token de autenticação Umbler
UMBLER_API_TOKEN=seu-token-aqui

# ========================================
# Banco de Dados
# ========================================

DATABASE_URL=sua-connection-string-aqui

# ========================================
# Cloudflare R2 / AWS S3 (Para arquivos)
# ========================================

CLOUDFLARE_URL=sua-url-cloudflare-r2
AWS_ACCESS_KEY_ID=seu-access-key
AWS_SECRET_ACCESS_KEY=seu-secret-key
CLOUDFLARE_BUCKET_NAME=seu-bucket-name
# Domínio público (CDN) que serve o bucket R2 — usado para gerar links de mídia
# acessíveis externamente (ex.: header de imagem de templates do WhatsApp).
R2_PUBLIC_URL=https://eventos.grandcrub2b.com

# ========================================
# Papel do processo
# ========================================

# "web"  → só serve HTTP. Nenhum job de background é agendado, o que permite ao
#          Replit Autoscale escalar a zero quando ninguém está usando o CRM.
#          Padrão quando NODE_ENV=production.
# "all"  → agenda os jobs dentro do próprio processo. Padrão fora de produção,
#          para `npm run dev` continuar sendo um processo só.
#
# Em produção os jobs rodam em Scheduled Deployments do Replit, um por grupo,
# executando `npm run job -- <grupo>`. Ver server/jobs/registry.ts para a lista
# de grupos e suas expressões cron.
# APP_ROLE=web

# ========================================
# Baileys Gateway dedicado (canais via QR)
# ========================================

# OBRIGATÓRIO: URL pública HTTPS do Baileys Gateway dedicado.
GATEWAY_URL=https://seu-gateway.example
# OBRIGATÓRIO: Bearer token compartilhado exclusivamente com o gateway.
GATEWAY_API_KEY=chave-forte-compartilhada-com-o-gateway
# OBRIGATÓRIO: mesmo WEBHOOK_SIGNING_SECRET do gateway (mín. 32 chars).
WEBHOOK_SIGNING_SECRET=segredo-hmac-com-no-minimo-32-caracteres

